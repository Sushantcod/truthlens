# TruthLens Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=truthlens-production-cryptographic-secret-key-change-in-prod-2026
DATABASE_URL=sqlite:///truthlens.db
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://

# Optional External Fact-Checking APIs (Disabled gracefully when unset)
GOOGLE_FACT_CHECK_API_KEY=
NEWS_API_KEY=

# Optional Mail Server (Falls back to console token printout when unset)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@truthlens.org

